[Unit]
Description=Host Sentinel local response broker
After=systemd-logind.service
Wants=systemd-logind.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=host-sentinel
RuntimeDirectory=host-sentinel-response
RuntimeDirectoryMode=0750
StateDirectory=host-sentinel-response
StateDirectoryMode=0700
ExecStart=/usr/local/bin/host-sentinel --config /etc/host-sentinel/config.toml response-agent
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_KILL
ReadWritePaths=/var/lib/host-sentinel-response /run/host-sentinel-response

[Install]
WantedBy=multi-user.target
